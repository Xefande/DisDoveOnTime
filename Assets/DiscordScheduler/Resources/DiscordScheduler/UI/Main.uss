/* DisDoveOnTime UI Toolkit theme
   Palette source: discordscheduler.xefande.com web UI.
   Keep values explicit because Unity USS custom property support differs by version. */

.root {
    flex-direction: row;
    height: 100%;
    width: 100%;
    padding: 12px;
    background-color: #0d1014;
    color: #f5f7fb;
}

.appRoot {
    min-width: 0;
    min-height: 0;
}

.nav {
    width: 252px;
    flex-shrink: 0;
    padding: 12px;
    border-radius: 8px;
    background-color: #111722;
    border-width: 1px;
    border-color: #2b3444;
}

.appSidebar {
    flex-direction: column;
}

.brandBlock {
    padding-bottom: 12px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2b3444;
}

.appTitle,
.brandTitle {
    -unity-font-style: bold;
    font-size: 19px;
    color: #f5f7fb;
}

.brandSubtitle {
    font-size: 11px;
    color: #47d6b6;
    margin-top: 2px;
}

.navList {
    flex-direction: column;
}

.content {
    flex-grow: 1;
    min-width: 600px;
    min-height: 0;
    margin-left: 12px;
    padding: 14px;
    border-radius: 8px;
    background-color: #141923;
    border-width: 1px;
    border-color: #2b3444;
    flex-direction: column;
}

.contentShell {
    flex-grow: 1;
}

.spacer {
    flex-grow: 1;
}

.view {
    display: none;
    height: 100%;
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.viewHeader {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    min-height: 48px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #2b3444;
}

.headerActions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
}

.headerActions > * {
    margin-left: 8px;
    margin-top: 4px;
}

.h1 {
    -unity-font-style: bold;
    font-size: 22px;
    color: #f5f7fb;
    margin-bottom: 2px;
}

.h2 {
    -unity-font-style: bold;
    font-size: 14px;
    color: #f5f7fb;
    margin-top: 2px;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 12px;
    color: #8793a7;
}

.small {
    font-size: 12px;
    color: #b9c2d2;
}

.hint {
    font-size: 12px;
    color: #8793a7;
    margin-top: 6px;
}

.bodyText {
    font-size: 12px;
    color: #b9c2d2;
    white-space: normal;
}

.emptyState {
    padding: 18px;
    border-radius: 8px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
    color: #b9c2d2;
    font-size: 13px;
    white-space: normal;
}

.compactEmpty {
    margin-top: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.selectionHint {
    margin-bottom: 10px;
    flex-shrink: 0;
}

.healthMini {
    padding: 10px;
    border-radius: 8px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
}

.healthMini:hover {
    border-color: #47d6b6;
    background-color: #141b27;
}

.healthMiniHeader {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.healthMiniTitle {
    -unity-font-style: bold;
    font-size: 12px;
    color: #f5f7fb;
}

.healthSummary {
    white-space: normal;
    margin-top: 2px;
}

.metricMiniRow {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.miniMetric {
    font-size: 10px;
    min-width: 62px;
    color: #b9c2d2;
    background-color: #171e2a;
    border-width: 1px;
    border-color: #2b3444;
    border-radius: 999px;
    padding: 3px 7px;
    -unity-text-align: middle-center;
    margin-right: 5px;
    margin-top: 4px;
}

.metricStrip {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.metricCard {
    min-width: 132px;
    flex-grow: 1;
    padding: 12px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: #171e2a;
    border-width: 1px;
    border-color: #2b3444;
}

.metricCard:hover {
    background-color: #1a2332;
    border-color: #47d6b6;
}

.metricLabel {
    font-size: 11px;
    color: #8793a7;
}

.metricValue {
    -unity-font-style: bold;
    font-size: 24px;
    color: #f5f7fb;
    margin-top: 4px;
}

.dashboardGrid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    min-height: 0;
}

.dashboardPanel {
    min-width: 260px;
    flex-grow: 1;
    margin-right: 10px;
    margin-bottom: 10px;
}

.dashboardPanelWide {
    flex-grow: 2;
}

.surface,
.pane,
.group {
    padding: 12px;
    border-radius: 8px;
    background-color: #171e2a;
    border-width: 1px;
    border-color: #2b3444;
}

.surface:hover,
.pane:hover,
.group:hover {
    border-color: #3a465b;
}

.formPanel {
    margin-bottom: 10px;
}

.reviewSummaryPanel {
    flex-shrink: 0;
    margin-bottom: 10px;
}

.vscroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 0;
}

.vscroll .unity-scroll-view__content-container {
    padding-right: 8px;
}

.split {
    flex-direction: row;
    height: 100%;
}

.splitFill {
    flex-grow: 1;
    min-height: 0;
    margin-top: 0;
}

.pane {
    flex-grow: 1;
    min-height: 0;
}

.paneList {
    min-width: 340px;
    max-width: 420px;
    flex-shrink: 0;
    margin-right: 10px;
}

.paneScroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 6px;
}

.formGrid {
    flex-direction: row;
    flex-wrap: wrap;
}

.formGrid > .formPanel {
    min-width: 320px;
    flex-grow: 1;
    margin-right: 10px;
}

.row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 8px;
}

.rowTop {
    align-items: flex-start;
}

.row > * {
    margin-right: 8px;
}

.rowEnd {
    margin-right: 0;
}

.rowWrap {
    flex-wrap: wrap;
    align-items: flex-start;
}

.rowWrap > * {
    margin-top: 6px;
    margin-bottom: 2px;
}

.fieldCol {
    flex-direction: column;
    margin-right: 14px;
}

.fieldColEnd {
    margin-right: 0;
}

.fieldLabel {
    font-size: 12px;
    color: #b9c2d2;
    margin-bottom: 4px;
}

.multiline,
.bodyField {
    height: 150px;
    min-height: 120px;
}

.bodyToolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
}

.bodyModeRow {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.bodyModeRow > * {
    margin-right: 10px;
}

.radioRow {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-radius: 999px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
}

.radioRow:hover {
    background-color: #171e2a;
    border-color: #47d6b6;
}

.radioToggle {
    min-width: 16px;
    margin-top: 2px;
}

.radioLabel {
    margin-left: 4px;
    color: #f5f7fb;
    font-size: 12px;
}

.counterLabel {
    align-self: flex-end;
    margin-top: 4px;
    padding: 4px 8px;
    border-radius: 999px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
    color: #b9c2d2;
}

.toolbarCounter {
    margin-top: 0;
    align-self: flex-start;
}

.smallField {
    min-width: 140px;
}

.payloadPreviewPayload {
    white-space: normal;
    padding: 8px;
    border-radius: 8px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
}

.group {
    margin-top: 12px;
    flex-shrink: 0;
}

.secretHint {
    border-left-width: 3px;
    border-left-color: #f0b45b;
    padding-left: 8px;
}

.list,
.log {
    flex-grow: 1;
    min-height: 220px;
    border-radius: 8px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
}

.list:hover,
.log:hover {
    border-color: #3a465b;
}

.log {
    padding: 10px;
}

.logLine {
    white-space: normal;
    color: #f5f7fb;
    margin-bottom: 6px;
}

.reviewList {
    margin-top: 10px;
}

.postRow {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: #202938;
}

.postRow:hover {
    background-color: #1a2332;
}

.postRowText {
    flex-grow: 1;
    min-width: 0;
    margin-left: 8px;
}

.postRowTitle {
    -unity-font-style: bold;
    font-size: 12px;
    color: #f5f7fb;
}

.postRowMeta {
    font-size: 11px;
    color: #8793a7;
    margin-top: 2px;
}

.statusLine {
    padding: 6px 8px;
    border-radius: 8px;
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
}

.statusPill {
    -unity-font-style: bold;
    font-size: 10px;
    min-width: 78px;
    padding: 4px 8px;
    border-radius: 999px;
    color: #071017;
    -unity-text-align: middle-center;
    background-color: #9caaff;
}

.statusReady,
.statusQueued,
.statusSent {
    background-color: #47d6b6;
    color: #06120f;
}

.statusPending,
.statusSending,
.statusBackoff {
    background-color: #9caaff;
    color: #071017;
}

.statusReview,
.statusMissed {
    background-color: #f0b45b;
    color: #140d02;
}

.statusFailed,
.statusBlocked {
    background-color: #ff6b7a;
    color: #160609;
}

.statusDraft {
    background-color: #1d2533;
    color: #b9c2d2;
    border-width: 1px;
    border-color: #2b3444;
}

Button {
    height: 34px;
    min-width: 96px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #1d2533;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2b3444;
}

Button:hover {
    background-color: #263247;
    border-color: #5e70c7;
}

Button:focus {
    border-color: #47d6b6;
}

Button:active {
    background-color: #303d55;
}

Button:disabled {
    opacity: 0.45;
}

Button.unity-disabled {
    opacity: 1;
    background-color: #121824;
    border-color: #273142;
}

Button.unity-disabled .unity-button__text {
    color: #788398;
}

Button .unity-button__text {
    color: #f5f7fb;
}

.navBtn {
    height: 34px;
    min-width: 0;
    margin-top: 6px;
    -unity-text-align: middle-left;
}

.navBtnActive {
    background-color: #1d2533;
    border-color: #47d6b6;
}

.navBtnActive .unity-button__text {
    color: #f5f7fb;
}

.primary {
    -unity-font-style: bold;
    background-color: #748bff;
    border-color: #9caaff;
}

.primary:hover {
    background-color: #9caaff;
}

.primary .unity-button__text {
    color: #071017;
}

.primary.unity-disabled {
    background-color: #242c45;
    border-color: #394463;
}

.primary.unity-disabled .unity-button__text {
    color: #93a0bd;
}

.dangerButton {
    border-color: #5b2a34;
}

.dangerButton:hover {
    background-color: #3a1d27;
    border-color: #ff6b7a;
}

.dangerButton .unity-button__text {
    color: #ff9aa5;
}

.dangerButton.unity-disabled {
    background-color: #151b27;
    border-color: #3b2530;
}

.dangerButton.unity-disabled .unity-button__text {
    color: #8f626d;
}

.actionDisabled {
    opacity: 1;
    background-color: #121824;
    border-color: #273142;
}

.actionDisabled .unity-button__text {
    color: #788398;
}

.unity-base-field__label,
.unity-toggle__label {
    color: #b9c2d2;
    font-size: 12px;
}

TextField .unity-text-field__input,
TextField .unity-base-text-field__input,
IntegerField .unity-text-field__input,
IntegerField .unity-base-text-field__input,
.unity-text-field__input,
.unity-base-text-field__input {
    background-color: #11161f;
    color: #f5f7fb;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2b3444;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
}

TextField:hover .unity-text-field__input,
TextField:hover .unity-base-text-field__input,
IntegerField:hover .unity-text-field__input,
IntegerField:hover .unity-base-text-field__input {
    border-color: #3a465b;
}

TextField:focus .unity-text-field__input,
TextField:focus .unity-base-text-field__input,
IntegerField:focus .unity-text-field__input,
IntegerField:focus .unity-base-text-field__input {
    border-color: #47d6b6;
}

DropdownField .unity-popup-field__input,
DropdownField .unity-base-popup-field__input,
.unity-popup-field__input,
.unity-base-popup-field__input {
    background-color: #11161f;
    color: #f5f7fb;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2b3444;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
}

DropdownField:hover .unity-popup-field__input,
DropdownField:hover .unity-base-popup-field__input {
    border-color: #3a465b;
}

DropdownField:focus .unity-popup-field__input,
DropdownField:focus .unity-base-popup-field__input {
    border-color: #47d6b6;
}

Toggle .unity-toggle__checkmark {
    background-color: #11161f;
    border-width: 1px;
    border-color: #2b3444;
    border-radius: 6px;
}

Toggle:hover .unity-toggle__checkmark {
    border-color: #47d6b6;
}

.ping-ui {
    display: none;
}

TextField,
IntegerField,
TextArea {
    --unity-cursor-color: #f5f7fb;
    --unity-selection-color: rgba(116,139,255,0.35);
}

.modalOverlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.70);
}

.modalCard {
    background-color: #171e2a;
    border-width: 1px;
    border-color: #2b3444;
    border-radius: 10px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55);
}

.modalTitle,
.modalBody {
    color: #f5f7fb;
}

.modalCard Button {
    background-color: #1d2533;
    border-color: #2b3444;
}

.modalCard Button:hover {
    background-color: #263247;
    border-color: #47d6b6;
}

.modalClose {
    background-color: #11161f;
    border-color: #2b3444;
}

.isSelected {
    background-color: #748bff;
    border-color: #9caaff;
}

.dateDow,
.timeTitle {
    color: #b9c2d2;
}

.modalCard Button .unity-button__text {
    color: #f5f7fb;
}

.mediaPreviewContainer {
    margin-top: 8px;
    flex-direction: column;
}

.mediaPreview {
    width: 320px;
    height: 180px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2b3444;
    background-color: #11161f;
    -unity-background-scale-mode: scale-to-fit;
}
